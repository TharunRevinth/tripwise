# TripWise Environment Configuration
# Copy this file to .env.local to configure your live credentials.

# --- SUPABASE CONFIGURATION (Track 3: Full-Stack Persistence) ---
# Obtain these from your Supabase Project Settings -> API: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- AI PROVIDERS (Use either OpenRouter OR NVIDIA NIM) ---
# Option 1: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: NVIDIA NIM (1,000 free credits at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- OPTIONAL: GEOAPIFY PLACES API ---
# Sign up at https://myprojects.geoapify.com for 3,000 free requests/day
GEOAPIFY_API_KEY=

# Note: Open-Meteo Weather API requires ZERO configuration and works out of the box!
